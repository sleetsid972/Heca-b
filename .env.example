# Telegram Bot Configuration
API_ID=your_telegram_api_id
API_HASH=your_telegram_api_hash
BOT_TOKEN=your_bot_token

# Admin Configuration
ADMIN_IDS=123456789,987654321  # Comma-separated list of admin user IDs (first one is owner)
OWNER_ID=123456789  # Owner ID (usually same as first admin)
PVT_CHANNEL_ID=-1001234567890  # Private channel ID for logging (optional)

# API Endpoints
# VPS1 (16GB/4c): Primary API on port 5000
# VPS2 (8GB/4c): Secondary API on port 5000
# Format: http://ip:port/shopify (endpoints must end with /shopify)
API_ENDPOINTS=http://VPS1_IP:5000/shopify,http://VPS2_IP:5000/shopify

# Performance Settings
MASS_CHECK_WORKERS=20  # Number of concurrent card checks in mass check mode

# API Server Settings (for api.py on VPS1 and VPS2)
WORKERS=6  # Hypercorn workers (use 6 on VPS1, 4 on VPS2)
PORT=5000  # API port
HOST=0.0.0.0  # Listen on all interfaces
